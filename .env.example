# Backend API URL
# Local:              http://localhost:8080
# Docker via Traefik: "" (empty string — relative URLs on the shared host)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Data source mode
# true  — real backend; prices and portfolio values come from it
# false — demo mode: the app runs entirely on mock data, no backend needed
NEXT_PUBLIC_USE_BACKEND=false

# Local dev only: inject X-User-Id directly so psina is not needed.
# Must be a user UUID the backend will provision.
# NEXT_PUBLIC_MOCK_USER_ID=
